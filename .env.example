# Copy to .env.local for local dev. Never commit real values.
# In production these are set in the Vercel dashboard.

# Phase 2 — database (Neon/Supabase Postgres)
# DATABASE_URL=

# Phase 2 — NextAuth (admin login)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Phase 2 — admin seed (only read once, by `npx prisma db seed`, to create
# the one admin login — not read at runtime, safe to remove after seeding)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Phase 2 — media uploads (Supabase Storage, same project as DATABASE_URL)
# Project Settings -> API Keys in the Supabase dashboard. SECRET_KEY bypasses
# RLS -- server-only, never expose it to the browser (no NEXT_PUBLIC_ prefix).
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
